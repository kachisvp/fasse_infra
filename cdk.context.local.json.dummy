  "dev": {
    "accessKeyHashMapJson": {
      "<sha256-hash-of-access-key-1>": "demo1",
      "<sha256-hash-of-access-key-2>": "demo2"
    },
    "jwtPublicKeyPemBase64": "<base64-encoded-public-key-pem>",
    "jwtSigningKeyArn": "arn:aws:kms:ap-northeast-1:<account-id>:key/<key-id>",
    "cognitoUserPoolId": "<stg-user-pool-id>",
    "cognitoClientId": "<stg-app-client-id>"
  }
